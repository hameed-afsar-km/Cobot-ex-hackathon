rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Mirrors NEXT_PUBLIC_SUPER_ADMIN_EMAILS / NEXT_PUBLIC_ADMIN_EMAILS
    // from .env.local. Keep both lists in sync.
    function envSuperAdminEmails() {
      return [
        'hameedafsar2006@gmail.com',
        '240071601263@crescent.education'
      ];
    }

    function envAdminEmails() {
      return [
        '240071601226@crescent.education'
      ];
    }

    function isEnvSuperAdmin() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() in envSuperAdminEmails();
    }

    function isEnvAdmin() {
      return isEnvSuperAdmin() || (
        isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() in envAdminEmails()
      );
    }

    function isAdmin() {
      return isEnvAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
      );
    }

    function isSuperAdmin() {
      return isEnvSuperAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    // Admins allowlist & management
    match /admins/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // Competitions configuration
    match /competitions/{competitionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Private team records
    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Private score entries
    match /scores/{scoreId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Score revision audit history
    match /score_history/{historyId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Leaderboard point-in-time snapshots
    match /leaderboard_snapshots/{snapshotId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Public projected leaderboard: Top-3 concealed before reveal!
    match /public_leaderboards/{competitionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reveal state machine: Public can read for synchronous animations
    match /reveal/{competitionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Activity logs: Audit trail
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
